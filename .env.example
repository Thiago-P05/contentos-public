# Copy to .env.local and fill in. Never commit the filled version.
# src/lib/env.ts is the authoritative schema — almost everything here is
# optional, and features degrade gracefully when their keys are absent.
#
# REQUIRED to boot: the Supabase block, AUTH_SECRET,
# CONNECTION_ENCRYPTION_SECRET and one of ALLOWED_USER_EMAIL / ALLOWED_USER_ID.

# ── Core ─────────────────────────────────────────────
# Public origin of the deployment. Origin checks on mutations compare against it.
APP_URL=
# Public, canonical URL of the MCP server. e.g. https://app.example.com/mcp
MCP_SERVER_URL=
# The single authorised user. Create them in Supabase > Authentication and copy
# the user ID. Access is an allowlist of exactly one person.
ALLOWED_USER_EMAIL=
ALLOWED_USER_ID=

# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. Set them before `pnpm build`, or rebuild after changing them.
# Exporting them only for `pnpm start` has no effect. (On Vercel this is
# automatic — it builds after your environment variables are in place.)

# Name shown in the sidebar. Default: "Acme"
NEXT_PUBLIC_APP_NAME=
# Account to pre-select before the user picks one.
# Optional: empty = the first available connection wins.
NEXT_PUBLIC_DEFAULT_CONNECTION_USERNAME=

# ── Auth ─────────────────────────────────────────────
# Signs OAuth state and encrypts stored secrets. Random 32+ chars.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Encrypts platform OAuth tokens at rest (falls back to AUTH_SECRET).
# Changing it makes already-stored tokens unreadable — you'd reconnect accounts.
CONNECTION_ENCRYPTION_SECRET=

# ── Supabase ─────────────────────────────────────────
# Project Settings > API. The service role key bypasses RLS: server-side only,
# never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OpenRouter: analysis and transcription ───────────
# https://openrouter.ai/keys
# Each function gets its OWN key on purpose: a runaway transcription job must not
# be able to exhaust the analysis budget. Do not merge them.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ANALYSIS=
OPENROUTER_API_KEY_ANALYSIS_COMPETENCIA=
OPENROUTER_API_KEY_TRANSCRIPTION=
OPENROUTER_BASE_URL=
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_ANALYSIS_COMPETENCIA_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=

# ── Langfuse (optional) ──────────────────────────────
# LLM tracing and cost tracking. https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=
LANGFUSE_DEBUG=

# ── Apify (optional) ─────────────────────────────────
# Competitor scraping. https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=

# ── OpusClip (optional) ──────────────────────────────
OPUSCLIP_API_KEY=
OPUSCLIP_ORG_ID=
OPUSCLIP_API_BASE_URL=

# ── Instagram ────────────────────────────────────────
# Your own app at https://developers.facebook.com — Instagram Graph API.
# Needs a Business/Creator account linked to a Facebook Page, and App Review for
# production scopes. Redirect URI: <APP_URL>/api/oauth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_BASE_URL=
INSTAGRAM_GRAPH_API_VERSION=

# ── TikTok ───────────────────────────────────────────
# Your own app at https://developers.tiktok.com
# Redirect URI: <APP_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── YouTube / Google OAuth ───────────────────────────
# https://console.cloud.google.com — enable YouTube Data API v3.
# Redirect URI: <APP_URL>/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Upstash Redis (optional) ─────────────────────────
# Caching and rate limiting on serverless. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron and sync ────────────────────────────────────
# Shared secret protecting /api/sync/cron. Set it in your host's env too.
CRON_SECRET=
# Oldest content the sync reaches for (ISO 8601). Bounds how far back your
# history goes and how much every run has to walk.
# Default: 2025-12-01T00:00:00-03:00
BACKFILL_START_ISO=
# Comma-separated connection IDs that must never trigger AI analysis.
# Useful when the same content is published across several platforms.
SKIP_AI_ANALYSIS_CONNECTIONS=
